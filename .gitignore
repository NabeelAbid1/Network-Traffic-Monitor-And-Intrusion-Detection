# ---- Build output ----
build*/
cmake-build-*/
out/
bin/

# ---- Generated at runtime (keep the folder, ignore what's inside) ----
output/*
!output/.gitkeep
*.log

# ---- Third-party source (each person keeps their own copy) ----
PcapPlusPlus/

# ---- Compiled files ----
*.exe
*.obj
*.o
*.a
*.lib
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.exp
*.out

# ---- CMake generated (matters only for in-source builds) ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
CMakeUserPresets.json

# ---- Editors / IDEs ----
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.vs/
.cache/
*.user
*.suo

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Packet captures (large or may contain sensitive data) ----
*.pcap
*.pcapng

