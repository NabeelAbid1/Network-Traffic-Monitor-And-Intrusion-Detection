# Build output
build/
build-ucrt64/
out/
bin/

# Generated output (alerts, logs)
output/

# Third-party source, each person keeps their own copy
PcapPlusPlus/

# Compiled files
*.exe
*.obj
*.o
*.dll
*.lib
*.pdb

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json

# VS Code machine-specific settings
.vscode/c_cpp_properties.json

# Visual Studio
.vs/
*.user
*.suo

# OS files
.DS_Store
Thumbs.db

# Captures (large or sensitive, never committed)
*.pcap
*.pcapng

# Ignore stray text files...
*.txt

# ...except what the program needs to build and run (keep BELOW *.txt)
!CMakeLists.txt
!rules/*.txt